java_library {
    name: "com.darshan.ambientlight.sdk",
    srcs: ["src/**/*.kt"],
    system_ext_specific: true,

    libs: [
        "com.darshan.ambientlight-V1-java",
    ],

    installable: true,

    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard.flags"],
    },
}