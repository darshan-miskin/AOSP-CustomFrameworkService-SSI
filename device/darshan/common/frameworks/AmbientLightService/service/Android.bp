java_library {
    name: "com.darshan.server.ambientlight",
    srcs: [
        "**/*.kt",
    ],
    aidl: {
        local_include_dirs: ["."],
    },
    static_libs: [
        "com.darshan.ambientlight-V1-java",
        "kotlin-stdlib",
    ],
    libs: [
        "services.core",
    ],
    system_ext_specific: true,
    platform_apis: true,
    installable: true,
}
